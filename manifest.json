{
  "manifest_version": 3,
  "name": "X Audience Screenshot",
  "version": "0.1.0",
  "description": "Screenshot your X audience analytics page and view it in the popup and in the front-end page.",
  "permissions": ["tabs", "debugger", "storage", "unlimitedStorage"],
  "host_permissions": ["https://x.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture X audience analytics"
  }
}
